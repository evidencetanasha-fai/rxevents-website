<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="RxEvents.SiteMaster" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        <asp:ContentPlaceHolder ID="TitleContent"
            runat="server">
            Rx Events Solutions
        </asp:ContentPlaceHolder>
    </title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Rx Events CSS -->
    <link href="<%: ResolveUrl("~/Content/css/site.css") %>"
          rel="stylesheet" />

</head>

<body>

    <form id="form1" runat="server">

        <!-- ================= HEADER ================= -->

        <header class="rx-header">

            <!-- Brand -->

            <div class="rx-brand">

    <img src="Content/images/rx-events-logo.png"
         alt="Rx Events Solutions Logo"
         class="rx-logo-image" />

    <div class="rx-brand-text">

        <div class="rx-brand-main">
            Rx Events Solutions
        </div>

        <div class="rx-brand-sub">
            Creating Memorable moments
        </div>

    </div>

</div>


            <!-- Navigation -->

            <nav class="rx-top-navigation">

    <a href="Home.aspx" class="active">
        Home
    </a>

    <a href="Services.aspx">
    Services
</a>
                <a href="Events.aspx">Events</a>

    <a href="Packages.aspx">
        Packages
    </a>

    <a href="Gallery.aspx">
        Gallery
    </a>

    <a href="Testimonials.aspx">
        Testimonials
    </a>

    <a href="About.aspx">
        About Us
    </a>

    <a href="Contact.aspx">
        Contact
    </a>

</nav>


            <!-- Authentication -->

            <div class="rx-auth-buttons">

                <a href="Login.aspx"
                   class="rx-login">
                    Login
                </a>

                <a href="Register.aspx"
                   class="rx-register">
                    Register
                </a>

            </div>

        </header>


        <!-- ================= MAIN CONTENT ================= -->

        <main>

            <asp:ContentPlaceHolder
                ID="MainContent"
                runat="server">
            </asp:ContentPlaceHolder>

        </main>


        <!-- ================= FOOTER ================= -->

        <footer class="rx-footer">

            <div class="rx-footer-content">

                <div>

                    <h3>Rx Events Solutions</h3>

                    <p>
    We plan, design and create unforgettable
    experiences for every special occasion.
</p>

                </div>


                <div>

                    <h4>Quick Links</h4>

                    <a href="Home.aspx">
                        Home
                    </a>

                    <a href="#">
                        Services
                    </a>

                    <a href="#">
                        Packages
                    </a>

                    <a href="#">
                        Gallery
                    </a>

                </div>


                <div>

                    <h4>Contact Us</h4>

                    <p>
                        Email: info@rxevents.com
                    </p>

                    <p>
                        Phone: +91 00000 00000
                    </p>

                </div>

            </div>


            <div class="rx-footer-bottom">

                <p>
                    © 2026 Rx Events Solutions.
                    All Rights Reserved.
                </p>

            </div>

        </footer>

    </form>

</body>

</html>